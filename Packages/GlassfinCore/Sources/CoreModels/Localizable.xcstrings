    "Server version %@ is not supported. Version %@ or later is required.": {
      "comment": "Shown when a server version is unsupported. The first %@ is the server version; the second %@ is the minimum required version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server version %@ is not supported. Version %@ or later is required."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinversio %@ ei ole tuettu. Vaaditaan vähintään %@."
          }
        }
      }
    },
